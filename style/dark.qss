/* =====================================================================
   FieldLink 深色主题 v2 — “现代控制台”设计语言
   深蓝黑底 · 靛蓝→紫渐变主按钮 · 青色点缀 · 大圆角卡片 · 胶囊状态灯
   配套 thememanager.h 的 QPalette 使用。
   ===================================================================== */

/* ---------- 全局 ---------- */
QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #e8edf7;
}
QMainWindow, QDialog {
    background-color: #10151f;
}
QToolTip {
    background-color: #0b0f18;
    color: #e8edf7;
    border: 1px solid #6366f1;
    padding: 5px 10px;
    border-radius: 6px;
}
QLabel {
    background: transparent;
}

/* ---------- 品牌头部 ---------- */
QFrame#headerBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(99, 102, 241, 0.14),
        stop:0.55 rgba(16, 21, 31, 0),
        stop:1 rgba(34, 211, 238, 0.08));
    border: 1px solid #1d2536;
    border-radius: 14px;
}
QFrame#accentDot {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6366f1, stop:1 #22d3ee);
    border: none;
    border-radius: 8px;
}
QLabel#brandTitle {
    font-size: 15pt;
    font-weight: 800;
    color: #f1f5fd;
    letter-spacing: 0.5px;
}
QLabel#brandSubtitle {
    font-size: 8.5pt;
    color: #6b7a94;
    letter-spacing: 1px;
}
/* 状态胶囊：未连接=红，连接[connected="true"]=绿 */
QLabel#statusChip {
    background: rgba(248, 113, 113, 0.10);
    color: #f87171;
    border: 1px solid rgba(248, 113, 113, 0.35);
    border-radius: 13px;
    padding: 4px 14px;
    font-size: 9pt;
    font-weight: 600;
}
QLabel#statusChip[connected="true"] {
    background: rgba(52, 211, 153, 0.10);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.40);
}

/* ---------- 连接卡片 ---------- */
QFrame#connectionCard {
    background: #151b28;
    border: 1px solid #222c42;
    border-radius: 14px;
}
QFrame#connectionCard QLabel {
    color: #9fb0c9;
    font-size: 9.5pt;
}

/* ---------- 菜单栏（扁平分段导航） ---------- */
QMenuBar {
    background: transparent;
    color: #c7d2fe;
    padding: 4px 8px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 14px;
    border-radius: 8px;
    margin-left: 2px;
}
QMenuBar::item:selected {
    background: #1c2540;
    color: #a5b4fc;
}
QMenuBar::item:pressed {
    background: #232e50;
}

/* ---------- 菜单与右键菜单 ---------- */
QMenu {
    background-color: #131a29;
    color: #e8edf7;
    border: 1px solid #263046;
    border-radius: 12px;
    padding: 8px;
}
QMenu::item {
    padding: 8px 30px 8px 14px;
    border-radius: 8px;
    background: transparent;
}
QMenu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1, stop:1 #7c5cf6);
    color: #ffffff;
}
QMenu::item:disabled {
    color: #4b5872;
}
QMenu::separator {
    height: 1px;
    background: #232d42;
    margin: 6px 10px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: #1b2434;
    color: #dbe4f5;
    border: 1px solid #2a3550;
    border-radius: 10px;
    padding: 7px 20px;
    min-height: 22px;
}
QPushButton:hover {
    background-color: #232e44;
    border-color: #3d4c74;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #16202f;
}
QPushButton:disabled {
    color: #4b5872;
    background-color: #151c29;
    border-color: #222c42;
}
QPushButton:default {
    border-color: #6366f1;
}

/* 主操作按钮：靛蓝→紫渐变 */
QPushButton#connectButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1, stop:1 #8b5cf6);
    color: #ffffff;
    font-weight: 700;
    border: none;
    border-radius: 10px;
    padding: 8px 26px;
}
QPushButton#connectButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7d80f5, stop:1 #a078f8);
}
QPushButton#connectButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4f52d8, stop:1 #7449d8);
}
QPushButton#connectButton:disabled {
    background-color: #2a3050;
    color: #5a6385;
}

/* 次级强调按钮：写操作用青色描边 */
QPushButton#writeButton {
    color: #67e8f9;
    border: 1px solid #155e75;
    background-color: rgba(34, 211, 238, 0.06);
}
QPushButton#writeButton:hover {
    border-color: #22d3ee;
    background-color: rgba(34, 211, 238, 0.14);
    color: #a5f3fc;
}
QPushButton#writeButton:disabled {
    color: #3f5265;
    border-color: #223047;
    background-color: transparent;
}

/* 设置对话框“应用”按钮 */
QPushButton#applyButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1, stop:1 #8b5cf6);
    color: #ffffff;
    font-weight: 700;
    border: none;
    border-radius: 12px;
}
QPushButton#applyButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7d80f5, stop:1 #a078f8);
}
QPushButton#applyButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4f52d8, stop:1 #7449d8);
}

/* ---------- 卡片式 GroupBox ---------- */
QGroupBox {
    background-color: #151b28;
    border: 1px solid #222c42;
    border-radius: 14px;
    margin-top: 22px;
    padding: 16px 12px 12px 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 8px;
    padding: 0 8px;
    color: #818cf8;
    background: transparent;
    letter-spacing: 1px;
}
QGroupBox:disabled {
    border-color: #1c2434;
}

/* ---------- 输入类控件 ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QAbstractSpinBox {
    background-color: #0c1018;
    color: #e8edf7;
    border: 1px solid #263046;
    border-radius: 10px;
    padding: 5px 10px;
    min-height: 22px;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #34415f;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #6366f1;
    background-color: #0f1524;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: #4b5872;
    background-color: #10141f;
    border-color: #1c2434;
}

/* ComboBox 下拉箭头（CSS 三角形画法） */
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #7c8bb0;
    margin-right: 10px;
}
QComboBox QAbstractItemView {
    background-color: #131a29;
    color: #e8edf7;
    border: 1px solid #263046;
    border-radius: 10px;
    padding: 6px;
    outline: none;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
}

/* SpinBox 上下按钮与箭头 */
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 18px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: #232e44;
    border-radius: 4px;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #7c8bb0;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #7c8bb0;
}

/* ---------- 列表 / 树 / 表格视图 ---------- */
QAbstractItemView {
    background-color: #0e1320;
    alternate-background-color: #121a2b;
    color: #e8edf7;
    border: 1px solid #222c42;
    border-radius: 12px;
    padding: 3px;
    outline: none;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
}
QAbstractItemView:disabled {
    color: #4b5872;
    background-color: #10141f;
}
QAbstractItemView::item {
    min-height: 27px;
    border: none;
    border-radius: 6px;
}
QAbstractItemView::item:hover {
    background-color: #1a2438;
}
QAbstractItemView::item:selected {
    background-color: #6366f1;
    color: #ffffff;
}

/* 表头 */
QHeaderView {
    background-color: transparent;
    border: none;
}
QHeaderView::section {
    background-color: transparent;
    color: #7c8bb0;
    border: none;
    border-bottom: 1px solid #222c42;
    padding: 7px 12px;
    font-weight: 600;
    font-size: 9pt;
}
QHeaderView::section:checked {
    color: #a5b4fc;
}
QTableCornerButton::section {
    background-color: transparent;
    border: none;
}

/* ---------- 文本编辑区 ---------- */
QPlainTextEdit, QTextEdit {
    background-color: #0e1320;
    color: #e8edf7;
    border: 1px solid #222c42;
    border-radius: 12px;
    padding: 6px;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #2b3550;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #6366f1;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #2b3550;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #6366f1;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    background: none;
    border: none;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
}

/* ---------- 指示器 ---------- */
QCheckBox, QRadioButton {
    spacing: 8px;
    background: transparent;
}
QRadioButton::indicator, QCheckBox::indicator {
    width: 15px;
    height: 15px;
}

/* ---------- 标签页 ---------- */
QTabWidget::pane {
    background-color: #151b28;
    border: 1px solid #222c42;
    border-radius: 12px;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #7c8bb0;
    padding: 8px 20px;
    border: 1px solid transparent;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
QTabBar::tab:selected {
    color: #a5b4fc;
    background: #151b28;
    border-color: #222c42;
    border-top: 2px solid #6366f1;
}
QTabBar::tab:hover:!selected {
    color: #e8edf7;
    background: #1a2233;
}

/* ---------- 进度条 ---------- */
QProgressBar {
    background-color: #0e1320;
    border: 1px solid #222c42;
    border-radius: 7px;
    text-align: center;
    color: #e8edf7;
    min-height: 14px;
}
QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1, stop:1 #22d3ee);
    border-radius: 6px;
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background-color: #0c1018;
    color: #6b7a94;
    border-top: 1px solid #1d2536;
}
QStatusBar QLabel {
    color: #6b7a94;
    padding: 0 4px;
}
QStatusBar::item {
    border: none;
}

/* ---------- 其它 ---------- */
QSplitter::handle {
    background-color: #1d2536;
}
QSplitter::handle:hover {
    background-color: #6366f1;
}
QMessageBox {
    background-color: #151b28;
}
